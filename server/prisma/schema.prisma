// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  NGO
  RESTAURANT
  VOLUNTEER
}

enum VolunteerStatus {
  PENDING
  VERIFIED
  ACTIVE
  REJECTED
}

enum FoodListingStatus {
  AVAILABLE
  REQUESTED
  PICKED
}

enum FoodRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id                       Int       @id @default(autoincrement())
  name                     String
  email                    String    @unique
  phone                    String?   @db.VarChar(20)
  password                 String
  role                     UserRole  @default(RESTAURANT)
  isVerified               Boolean   @default(false) @map("is_verified")
  verificationToken        String?   @map("verification_token")
  verificationTokenExpiry  DateTime? @map("verification_token_expiry")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  // Relationships
  admin         Admin?
  ngo           NGO?
  restaurant    Restaurant?
  volunteer     Volunteer?
  notifications Notification[]
  donorPayments Payment[]     @relation("donorPayments")
  ngoPayments   Payment[]     @relation("ngoPayments")
  reviews       Review[]      @relation("reviewerRelation")

  @@map("users")
}

model Admin {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminLogs AdminLog[]

  @@map("admins")
}

model Restaurant {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique @map("user_id")
  shopName  String  @map("shop_name")
  shopType  String? @map("shop_type")
  address   String
  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  verified  Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relationships
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodListings FoodListing[]
  reviews      Review[]

  @@map("restaurants")
}

model NGO {
  id                 Int     @id @default(autoincrement())
  userId             Int     @unique @map("user_id")
  ngoName            String  @map("ngo_name")
  address            String
  latitude           Decimal @db.Decimal(10, 7)
  longitude          Decimal @db.Decimal(10, 7)
  coverageRadiusKm   Decimal @map("coverage_radius_km") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relationships
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests FoodRequest[]
  volunteers Volunteer[]
  reviews  Review[]

  @@map("ngos")
}

model FoodListing {
  id                 Int                @id @default(autoincrement())
  restaurantId       Int                @map("restaurant_id")
  foodName           String             @map("food_name")
  description        String?
  category           String?
  imageUrl           String?            @map("image_url")
  quantity           Int
  unit               String?
  pickupInstructions String?            @map("pickup_instructions")
  expiryTime         DateTime           @map("expiry_time")
  status             FoodListingStatus  @default(AVAILABLE)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relationships
  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  requests   FoodRequest[]

  @@index([restaurantId, status])
  @@index([status, expiryTime])
  @@map("food_listings")
}

model FoodRequest {
  id                 Int               @id @default(autoincrement())
  ngoId              Int               @map("ngo_id")
  foodListingId      Int               @map("food_listing_id")
  status             FoodRequestStatus @default(PENDING)
  pickupTime         DateTime?         @map("pickup_time")
  rejectionReason    String?           @map("rejection_reason")
  // Volunteer pickup verification
  assignedVolunteerId Int?             @map("assigned_volunteer_id")
  pickupQrToken      String?           @unique @map("pickup_qr_token")
  pickupOtp          String?           @map("pickup_otp")
  pickupOtpExpiry    DateTime?         @map("pickup_otp_expiry")
  pickupOtpVerified  Boolean           @default(false) @map("pickup_otp_verified")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  // Relationships
  ngo               NGO         @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  foodListing       FoodListing @relation(fields: [foodListingId], references: [id], onDelete: Cascade)
  assignedVolunteer Volunteer?  @relation(fields: [assignedVolunteerId], references: [id], onDelete: SetNull)
  pickupLog         PickupLog?
  reviews           Review[]

  @@index([ngoId, status])
  @@index([foodListingId, status])
  @@map("food_requests")
}

model PickupLog {
  id            Int      @id @default(autoincrement())
  foodRequestId Int      @unique @map("food_request_id")
  pickupCode    String   @unique @map("pickup_code")
  pickupStatus  String   @map("pickup_status")
  timestamp     DateTime @default(now())

  // Relationships
  foodRequest FoodRequest @relation(fields: [foodRequestId], references: [id], onDelete: Cascade)

  @@map("pickup_logs")
}

model Volunteer {
  id                 Int             @id @default(autoincrement())
  ngoId              Int             @map("ngo_id")
  userId             Int?            @unique @map("user_id")
  name               String
  email              String          @unique
  phone              String?         @db.VarChar(20)
  status             VolunteerStatus @default(PENDING)
  phoneVerified      Boolean         @default(false) @map("phone_verified")
  phoneOtp           String?         @map("phone_otp")
  phoneOtpExpiry     DateTime?       @map("phone_otp_expiry")
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  // Relationships
  ngo  NGO   @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedPickups FoodRequest[]

  @@map("volunteers")
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  type      String   // e.g., 'new_listing', 'request_accepted', 'pickup_completed'
  title     String
  body      String
  data      Json?    // Extra metadata for frontend handling
  channel   String   @default("IN_APP") // IN_APP, EMAIL, SMS
  isRead    Boolean  @default(false) @map("is_read")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, sentAt])
  @@map("notifications")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique @map("order_id")
  paymentId   String        @map("payment_id")
  donorId     Int?          @map("donor_id")
  ngoId       Int?          @map("ngo_id")
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("INR")
  status      PaymentStatus @default(PENDING)
  metadata    Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations (simplified to User for now)
  donor User? @relation("donorPayments", fields: [donorId], references: [id], onDelete: SetNull)
  ngo   User? @relation("ngoPayments", fields: [ngoId], references: [id], onDelete: SetNull)

  @@index([donorId, status])
  @@index([ngoId, status])
  @@map("payments")
}

model Review {
  id              Int      @id @default(autoincrement())
  rating          Int      // 1-5 star rating
  comment         String?  @db.Text
  reviewerId      Int      @map("reviewer_id")
  reviewerRole    UserRole @map("reviewer_role")
  restaurantId    Int?     @map("restaurant_id")
  ngoId           Int?     @map("ngo_id")
  foodRequestId   Int?     @map("food_request_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relationships
  reviewer    User         @relation("reviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)
  restaurant  Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ngo         NGO?         @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  foodRequest FoodRequest? @relation(fields: [foodRequestId], references: [id], onDelete: SetNull)

  @@index([restaurantId, rating])
  @@index([ngoId, rating])
  @@index([reviewerId])
  @@map("reviews")
}

// ──────────────────────────────────────────────────────────────
// City-level aggregated statistics (updated periodically)
// ──────────────────────────────────────────────────────────────
model CityStats {
  id                  Int      @id @default(autoincrement())
  city                String   @unique
  totalDonations      Int      @default(0) @map("total_donations")
  totalMealsRescued   Int      @default(0) @map("total_meals_rescued")
  totalPeopleFed      Int      @default(0) @map("total_people_fed")
  activeRestaurants   Int      @default(0) @map("active_restaurants")
  activeNgos          Int      @default(0) @map("active_ngos")
  co2SavedKg          Decimal  @default(0) @db.Decimal(10, 2) @map("co2_saved_kg")
  lastUpdated         DateTime @default(now()) @map("last_updated")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([city])
  @@map("city_stats")
}

// ──────────────────────────────────────────────────────────────
// Administrative audit log
// ──────────────────────────────────────────────────────────────
model AdminLog {
  id          Int      @id @default(autoincrement())
  adminId     Int      @map("admin_id")
  action      String   // e.g. 'VERIFY_RESTAURANT', 'REJECT_NGO', 'DELETE_LISTING'
  targetType  String   @map("target_type") // 'Restaurant' | 'NGO' | 'FoodListing' | 'User'
  targetId    Int      @map("target_id")
  details     Json?    // Arbitrary metadata about the action
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relationships
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_logs")
}
