generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int            @id @default(autoincrement())
  name                    String
  email                   String         @unique
  phone                   String?        @db.VarChar(20)
  password                String?
  role                    UserRole       @default(RESTAURANT)
  updatedAt               DateTime       @updatedAt
  createdAt               DateTime       @default(now())
  businessVerified        Boolean        @default(false)
  authProvider            String         @default("JWT")
  isVerified              Boolean        @default(false)
  verificationToken       String?
  verificationTokenExpiry DateTime?
  isActive                Boolean        @default(true)
  suspendedBy             Int?
  suspendedAt             DateTime?
  suspensionReason        String?
  reactivatedBy           Int?
  reactivatedAt           DateTime?
  admin                   Admin?
  ngo                     NGO?
  notifications           Notification[]
  donorPayments           Payment[]      @relation("donorPayments")
  ngoPayments             Payment[]      @relation("ngoPayments")
  restaurant              Restaurant?
  reviews                 Review[]       @relation("reviewerRelation")
  volunteer               Volunteer?

  @@map("users")
}

model Admin {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  adminLogs AdminLog[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Restaurant {
  id           Int           @id @default(autoincrement())
  userId       Int           @unique @map("user_id")
  shopName     String        @map("shop_name")
  shopType     String?       @map("shop_type")
  address      String
  latitude     Decimal       @db.Decimal(10, 7)
  longitude    Decimal       @db.Decimal(10, 7)
  verified     Boolean       @default(false)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  foodListings FoodListing[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews      Review[]

  @@map("restaurants")
}

model NGO {
  id               Int           @id @default(autoincrement())
  userId           Int           @unique @map("user_id")
  ngoName          String        @map("ngo_name")
  address          String
  latitude         Decimal       @db.Decimal(10, 7)
  longitude        Decimal       @db.Decimal(10, 7)
  coverageRadiusKm Decimal       @map("coverage_radius_km") @db.Decimal(5, 2)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  requests         FoodRequest[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews          Review[]
  volunteers       Volunteer[]

  @@map("ngos")
}

model FoodListing {
  id                 Int               @id @default(autoincrement())
  restaurantId       Int               @map("restaurant_id")
  foodName           String            @map("food_name")
  quantity           Int
  expiryTime         DateTime          @map("expiry_time")
  status             FoodListingStatus @default(AVAILABLE)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  category           String?
  description        String?
  imageUrl           String?           @map("image_url")
  pickupInstructions String?           @map("pickup_instructions")
  unit               String?
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  requests           FoodRequest[]

  @@index([restaurantId, status])
  @@index([status, expiryTime])
  @@map("food_listings")
}

model FoodRequest {
  id                  Int               @id @default(autoincrement())
  ngoId               Int               @map("ngo_id")
  foodListingId       Int               @map("food_listing_id")
  status              FoodRequestStatus @default(PENDING)
  pickupTime          DateTime?         @map("pickup_time")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  assignedVolunteerId Int?              @map("assigned_volunteer_id")
  pickupOtp           String?           @map("pickup_otp")
  pickupOtpExpiry     DateTime?         @map("pickup_otp_expiry")
  pickupOtpVerified   Boolean           @default(false) @map("pickup_otp_verified")
  pickupQrToken       String?           @unique @map("pickup_qr_token")
  rejectionReason     String?           @map("rejection_reason")
  assignedVolunteer   Volunteer?        @relation(fields: [assignedVolunteerId], references: [id])
  foodListing         FoodListing       @relation(fields: [foodListingId], references: [id], onDelete: Cascade)
  ngo                 NGO               @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  pickupLog           PickupLog?
  reviews             Review[]

  @@index([ngoId, status])
  @@index([foodListingId, status])
  @@map("food_requests")
}

model PickupLog {
  id            Int         @id @default(autoincrement())
  foodRequestId Int         @unique @map("food_request_id")
  pickupCode    String      @unique @map("pickup_code")
  pickupStatus  String      @map("pickup_status")
  timestamp     DateTime    @default(now())
  foodRequest   FoodRequest @relation(fields: [foodRequestId], references: [id], onDelete: Cascade)

  @@map("pickup_logs")
}

model Volunteer {
  id                 Int             @id @default(autoincrement())
  ngoId              Int             @map("ngo_id")
  userId             Int?            @unique @map("user_id")
  name               String
  email              String          @unique
  phone              String?         @db.VarChar(20)
  status             VolunteerStatus @default(PENDING)
  phoneVerified      Boolean         @default(false) @map("phone_verified")
  phoneOtp           String?         @map("phone_otp")
  phoneOtpExpiry     DateTime?       @map("phone_otp_expiry")
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  assignedPickups    FoodRequest[]
  ngo                NGO             @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  user               User?           @relation(fields: [userId], references: [id])

  @@map("volunteers")
}

model Notification {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  type      String
  title     String
  body      String
  data      Json?
  channel   String   @default("IN_APP")
  isRead    Boolean  @default(false) @map("is_read")
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, sentAt])
  @@map("notifications")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique @map("order_id")
  paymentId String        @map("payment_id")
  donorId   Int?          @map("donor_id")
  ngoId     Int?          @map("ngo_id")
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("INR")
  status    PaymentStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  donor     User?         @relation("donorPayments", fields: [donorId], references: [id])
  ngo       User?         @relation("ngoPayments", fields: [ngoId], references: [id])

  @@index([donorId, status])
  @@index([ngoId, status])
  @@map("payments")
}

model Review {
  id            Int          @id @default(autoincrement())
  rating        Int
  comment       String?
  reviewerId    Int          @map("reviewer_id")
  reviewerRole  UserRole     @map("reviewer_role")
  restaurantId  Int?         @map("restaurant_id")
  ngoId         Int?         @map("ngo_id")
  foodRequestId Int?         @map("food_request_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  foodRequest   FoodRequest? @relation(fields: [foodRequestId], references: [id])
  ngo           NGO?         @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  restaurant    Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reviewer      User         @relation("reviewerRelation", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([restaurantId, rating])
  @@index([ngoId, rating])
  @@index([reviewerId])
  @@map("reviews")
}

model CityStats {
  id                Int      @id @default(autoincrement())
  city              String   @unique
  totalDonations    Int      @default(0) @map("total_donations")
  totalMealsRescued Int      @default(0) @map("total_meals_rescued")
  totalPeopleFed    Int      @default(0) @map("total_people_fed")
  activeRestaurants Int      @default(0) @map("active_restaurants")
  activeNgos        Int      @default(0) @map("active_ngos")
  co2SavedKg        Decimal  @default(0) @map("co2_saved_kg") @db.Decimal(10, 2)
  lastUpdated       DateTime @default(now()) @map("last_updated")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([city])
  @@map("city_stats")
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  adminId    Int      @map("admin_id")
  action     String
  targetType String   @map("target_type")
  targetId   Int      @map("target_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_logs")
}

enum UserRole {
  ADMIN
  NGO
  RESTAURANT
  VOLUNTEER
}

enum VolunteerStatus {
  PENDING
  VERIFIED
  ACTIVE
  REJECTED
}

enum FoodListingStatus {
  AVAILABLE
  REQUESTED
  PICKED
}

enum FoodRequestStatus {
  PENDING
  ACCEPTED
  COMPLETED
  REJECTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
