# SaveTheServe Frontend Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ========== API CONFIGURATION ==========
# Backend API base URL
# Development: http://localhost:3000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Socket.IO server URL (for real-time notifications)
# Should match your backend server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# ========== APP CONFIGURATION ==========
# Application name (displayed in UI)
NEXT_PUBLIC_APP_NAME="SaveTheServe"

# Application version
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ========== ANALYTICS (Optional) ==========
# Uncomment to enable analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ========== FEATURE FLAGS ==========
# Enable/disable features
# NEXT_PUBLIC_ENABLE_PAYMENTS=true
# NEXT_PUBLIC_ENABLE_REVIEWS=true
# NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ========== PRODUCTION ONLY ==========
# Only include non-sensitive configuration variables in .env.local
# Do NOT store API keys, secrets, or credentials here
# Frontend environment variables are exposed to client, so keep sensitive data on backend
